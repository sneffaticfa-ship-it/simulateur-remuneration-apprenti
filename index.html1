<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Espace métier de simulation de rémunération des apprentis du CFA de l’Académie de Nice / GIP FIPAN."><title>Repères • Rémunération des apprentis</title>
<style>
:root{--ink:#182a3c;--muted:#617183;--navy:#132f4c;--blue:#235ad0;--light:#eef3fb;--line:#dce3ec;--green:#22715a;--paper:#f5f7fa}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select,textarea{font:inherit}button,a,input,select,summary,textarea{outline-offset:4px}button{cursor:pointer}button:disabled{opacity:.5;cursor:default}a{color:var(--blue)}.shell{display:grid;grid-template-columns:242px 1fr;min-height:100vh}.sidebar{background:var(--navy);color:white;padding:32px 22px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column}.brand{display:flex;gap:12px;align-items:center;font-size:23px;font-weight:750;letter-spacing:-.7px}.mark{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:#fff;color:var(--navy);font-size:24px}.brand small{display:block;font-size:10px;letter-spacing:2.2px;font-weight:500;color:#b3c8df}.org{font-size:12px;color:#c4d4e5;margin:25px 0 32px;padding-bottom:24px;border-bottom:1px solid #34506b}.nav{display:grid;gap:6px}.nav button{text-align:left;border:0;background:transparent;color:#c4d4e5;border-radius:8px;padding:12px 13px;display:flex;gap:12px;align-items:center}.nav button.active{color:white;background:#2b4d70}.nav button span:first-child{font-size:19px;width:20px;text-align:center}.nav button:hover{background:#244563}.nav .count{margin-left:auto;background:#3a5c7d;font-size:11px;border-radius:6px;padding:0 6px}.sidefoot{margin-top:auto;font-size:11px;color:#b3c8df;padding-top:30px}.dot{display:inline-block;width:6px;height:6px;background:#72cbb1;border-radius:50%;margin-right:5px}.workspace{min-width:0}.topbar{height:72px;padding:0 44px;border-bottom:1px solid var(--line);background:#fff;display:flex;align-items:center;justify-content:space-between;font-size:12px;color:var(--muted)}.badge{display:inline-block;border:1px solid #d7e8df;color:var(--green);background:#f0f8f4;border-radius:20px;padding:4px 10px;font-size:11px;white-space:nowrap}.content{max-width:1340px;margin:auto;padding:34px 44px 44px}.eyebrow{color:var(--blue);text-transform:uppercase;font-size:11px;font-weight:750;letter-spacing:1.6px;margin:0 0 8px}h1{font-size:32px;line-height:1.2;letter-spacing:-1px;margin:0 0 10px}h2{font-size:18px;letter-spacing:-.3px;margin:0}h3{font-size:15px;margin:0 0 10px}p{margin:8px 0 16px}.muted,.hint{color:var(--muted)}.intro{display:flex;justify-content:space-between;align-items:center;gap:22px;margin-bottom:25px}.intro p{margin-bottom:0}.btn{border:1px solid var(--line);border-radius:7px;padding:9px 15px;background:white;color:var(--ink);font-size:13px;font-weight:650;display:inline-flex;gap:8px;align-items:center;justify-content:center;text-decoration:none}.btn:hover{background:#edf2f9}.primary{background:var(--blue);color:#fff;border-color:var(--blue)}.primary:hover{background:#1c49aa}.dark{background:var(--navy);color:#fff;border-color:var(--navy)}.textbtn{border:0;background:none;color:var(--blue);padding:4px;font-size:12px}.notice{border:1px solid #dce5f2;background:#edf3fd;padding:13px 17px;border-radius:8px;font-size:12px;display:flex;gap:12px;margin-bottom:24px}.notice b{color:#2a5385}.layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(310px,.85fr);gap:24px;align-items:start}.card{background:white;border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-bottom:20px}.cardhead{padding:19px 23px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:10px}.step{display:inline-grid;place-items:center;background:var(--light);border-radius:7px;width:28px;height:28px;margin-right:10px;color:var(--blue);font-size:12px}.cardbody{padding:22px 23px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:19px 18px}.wide{grid-column:1/-1}label{font-size:12px;font-weight:650;display:block;margin-bottom:7px}input,select,textarea{width:100%;border:1px solid #cbd5e1;background:#fff;color:var(--ink);border-radius:6px;padding:10px 11px;min-height:43px;font-size:14px}input:focus,select:focus,textarea:focus{border-color:var(--blue)}input[type=checkbox]{width:17px;min-height:17px;accent-color:var(--blue)}.check{display:flex;gap:10px;align-items:flex-start;font-size:13px;font-weight:500;margin:5px 0}.hint{font-size:11px;margin:5px 0 0;line-height:1.5}.inline-year{padding:12px;background:var(--light);border-radius:6px;color:#345577;font-size:12px}.result{background:var(--navy);color:#fff;border:0}.result .cardhead{border-color:#34506b}.result .cardhead small{font-size:10px;color:#b5c7d9;letter-spacing:1px}.result .cardbody{padding:25px}.money{font-size:43px;line-height:1.2;letter-spacing:-1.6px;font-weight:700;margin:10px 0 4px}.resultsub{font-size:12px;color:#c5d5e5}.rate{display:inline-block;background:#284c70;color:#dcecff;border:1px solid #41668b;border-radius:6px;padding:6px 11px;margin:20px 0 0;font-size:13px}.result dl{margin:22px 0 0;border-top:1px solid #34506b;padding-top:14px}.result dl div{display:flex;justify-content:space-between;font-size:12px;padding:5px 0;gap:10px}.result dt{color:#c5d5e5}.result dd{margin:0;text-align:right}.resultactions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:23px}.resultactions .btn{font-size:12px;background:white;color:var(--navy)}.resultactions .outline{background:transparent;border-color:#58738e;color:#fff}.rulelist{list-style:none;padding:0;margin:0}.rulelist li{font-size:12px;padding:11px 0;border-bottom:1px solid #edf0f5;display:flex;gap:11px}.rulelist li:last-child{border:0}.tick{color:var(--green);font-weight:bold}.warning{background:#fff8eb;border:1px solid #efdfbd;border-radius:7px;padding:12px 14px;font-size:12px;color:#795723;margin-top:10px}.warning p{margin:5px 0}.pill{background:var(--light);color:#3e5872;border-radius:5px;font-size:10px;padding:3px 7px}.footer{display:flex;justify-content:space-between;gap:16px;font-size:10px;color:var(--muted);padding:8px 0}.hidden,[hidden]{display:none!important}.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.tablewrap{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:13px}th{text-align:left;background:#f7f9fc;font-size:11px;color:var(--muted);font-weight:650}th,td{padding:13px 17px;border-bottom:1px solid var(--line);vertical-align:top}td strong{font-size:16px}.empty{text-align:center;padding:50px 24px;color:var(--muted)}.empty b{display:block;font-size:18px;color:var(--ink);margin-bottom:8px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.guidecard{padding:24px}.guidecard .step{margin-bottom:14px}.guidecard p{font-size:13px;color:var(--muted);margin-bottom:0}details{border-bottom:1px solid var(--line);padding:17px 23px}summary{font-weight:650;font-size:14px;cursor:pointer}details p,details li{font-size:13px;color:var(--muted)}.search{max-width:390px}.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#183c32;color:#fff;padding:12px 20px;border-radius:8px;z-index:20;font-size:13px;box-shadow:0 5px 30px #0002;max-width:90vw}.error{color:#a32222;background:#fff0f0;padding:12px;border-radius:6px;font-size:13px}.settingline{display:flex;justify-content:space-between;gap:20px;align-items:center}.sectiongap{margin-top:25px}.linklist{display:grid;gap:9px;font-size:13px}.bottomcalc{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 23px;border-top:1px solid var(--line);background:#fafbfd}.bottomcalc .hint{margin:0}.small{font-size:12px}.state{font-size:10px;color:#d1e4fa}.brandnote{font-size:11px;color:#a8bed5}body{color-scheme:light}@media(min-width:1100px){.rightcol{position:sticky;top:20px}}@media(max-width:1100px){.shell{grid-template-columns:210px 1fr}.sidebar{padding:25px 16px}.content{padding:28px}.topbar{padding:0 28px}.layout{grid-template-columns:1fr}.grid3{grid-template-columns:1fr}.rightcol{display:grid;grid-template-columns:1fr 1fr;gap:18px}.rightcol>.card{margin:0}.rightcol>.card:last-child{grid-column:1/-1}}@media(max-width:700px){.shell{display:block}.sidebar{position:relative;height:auto;padding:15px 18px}.brand{font-size:20px}.brand small{display:none}.org,.sidefoot{display:none}.nav{display:flex;gap:4px;overflow-x:auto;margin-top:15px}.nav button{white-space:nowrap;padding:9px 10px;font-size:12px}.nav button span:first-child{display:none}.nav .count{margin-left:0}.topbar{padding:0 18px;height:48px;font-size:10px}.topbar .trail{display:none}.content{padding:24px 16px}.intro{display:block}.intro>.btn{margin-top:15px}h1{font-size:27px}.fields{grid-template-columns:1fr}.wide{grid-column:auto}.rightcol{display:block}.rightcol>.card{margin-bottom:18px}.cardhead,.cardbody{padding:18px}.money{font-size:40px}.notice{font-size:11px}.footer{display:block}.grid3{gap:0}.settingline{display:block}.toolbar{margin:12px 0}.bottomcalc{padding:15px;align-items:flex-start}.resultactions{grid-template-columns:1fr 1fr}}@media print{.sidebar,.topbar,.intro .btn,.toolbar,.resultactions,.bottomcalc,.footer,button{display:none!important}.shell,.layout,.rightcol{display:block}.content{padding:0}.card{break-inside:avoid}.result{background:#fff;color:#182a3c;border:1px solid #dce3ec}.result *{color:#182a3c!important}.result .cardhead,.result dl{border-color:#dce3ec}}
</style></head><body>
<div class="shell"><aside class="sidebar"><div class="brand"><span class="mark">r.</span><div>repères<small>APPRENTISSAGE</small></div></div><div class="org">CFA de l’Académie de Nice<br><b>GIP FIPAN</b> · Espace collègues</div><nav class="nav" aria-label="Navigation principale"><button class="active" data-view="simulateur"><span>▦</span>Simulateur</button><button data-view="comparateur"><span>⇄</span>Comparateur <span class="count" id="compareCount">0</span></button><button data-view="historique"><span>◷</span>Historique</button><button data-view="tutoriel"><span>▤</span>Guide & tutoriel</button><button data-view="parametres"><span>⚙</span>Règles & barème</button></nav><div class="sidefoot"><span class="dot"></span>Version métier 3.0<br><p>Un cadre commun.<br>Des situations mieux comprises.</p><div class="brandnote">Département du Var · 83</div></div></aside>
<div class="workspace"><header class="topbar"><span>Espace métier <span class="trail"> / &nbsp; Rémunération des apprentis</span></span><span class="badge">Références vérifiées · 03 nov. 2026</span></header><main class="content">
<section id="simulateur" class="view"><div class="intro"><div><p class="eyebrow">Préparer • comprendre • comparer</p><h1>Simuler une rémunération</h1><p class="muted">Le bon repère pour chaque parcours d’apprentissage.</p></div><button class="btn" data-go="tutoriel">Consulter le guide ↗</button></div>
<div class="notice"><b>ⓘ</b><span>Estimation du minimum <b>brut mensuel à temps plein</b>. Les situations particulières et les accords plus favorables restent à vérifier avant d’établir le contrat.</span></div>
<div class="layout"><form id="simform" novalidate><div class="card"><div class="cardhead"><h2><span class="step">01</span>Profil & formation</h2><span class="pill">Situation à la date étudiée</span></div><div class="cardbody"><div class="fields">
<div><label for="age">Âge applicable au mois étudié</label><input id="age" type="number" min="15" max="80" step="1" value="19" required><p class="hint">À 18, 21 ou 26 ans, le nouveau taux prend effet le mois suivant l’anniversaire.</p></div><div><label for="date">Date de la simulation salariale</label><input id="date" type="date" value="2026-11-03" required><p class="hint">Détermine le SMIC de référence. L’âge reste à renseigner.</p></div>
<div class="wide"><label for="diploma">Diplôme ou certification préparée</label><select id="diploma"><option value="cap">CAP</option><option value="bac">Bac professionnel</option><option value="cs">Certificat de spécialisation (CS)</option><option value="mc">Mention complémentaire (ancien intitulé)</option><option value="bts" selected>BTS</option><option value="licence">Licence générale</option><option value="lp">Licence professionnelle</option><option value="bachelor">Bachelor / titre RNCP</option><option value="other">Autre diplôme ou titre</option></select></div>
<div><label for="level">Niveau de la certification</label><select id="level"><option value="3">Niveau 3 · CAP</option><option value="4">Niveau 4 · Bac</option><option value="5" selected>Niveau 5 · Bac +2</option><option value="6">Niveau 6 · Bac +3 / +4</option><option value="7">Niveau 7 · Bac +5</option></select><p class="hint">À confirmer sur la fiche RNCP. Le niveau seul ne fixe pas le taux.</p></div><div><label for="rncp">Code RNCP <span class="muted">(facultatif)</span></label><input id="rncp" placeholder="Ex. RNCP42631" maxlength="30"><p class="hint">Repère documentaire, sans interrogation automatique du registre.</p></div>
<div><label for="cycle">Durée normale du cycle (mois)</label><input id="cycle" type="number" min="6" max="60" step="1" value="24" required><p class="hint">Durée de référence de cette certification, avant réduction individuelle.</p></div><div><label for="duration">Durée du contrat préparant le diplôme (mois)</label><input id="duration" type="number" min="6" max="60" step="1" value="24" required><p class="hint">À distinguer de la durée normale du cycle.</p></div>
</div></div></div>
<div class="card"><div class="cardhead"><h2><span class="step">02</span>Parcours dans le contrat</h2></div><div class="cardbody"><div class="fields"><div><label for="year">Année d’exécution du contrat actuel</label><select id="year"><option value="1">1re année · mois 1 à 12</option><option value="2">2e année · mois 13 à 24</option><option value="3">3e année · mois 25 à 36</option></select><p class="hint">Le temps écoulé dans ce contrat, sans additionner les anciens contrats.</p></div><div><label for="entry">Positionnement à l’entrée dans le cycle</label><select id="entry"><option value="1">Début de cycle · 1re année</option><option value="2">Entrée directe en 2e année</option><option value="3">Entrée directe en 3e année</option></select><p class="hint">Pour un bac pro : 1re, 2e ou 3e année du cycle de 3 ans.</p></div>
<div class="wide"><label for="adjust">Aménagement de durée</label><select id="adjust"><option value="standard">Parcours standard</option><option value="reduced">Réduction formalisée du cycle</option><option value="extended">Prolongation / redoublement</option></select><p class="hint">Une entrée avancée suppose un positionnement pédagogique documenté. La durée courte d’un titre ne prouve pas une réduction.</p></div>
<div id="extensionBox" class="wide hidden"><label for="lastYear">Année de rémunération avant prolongation</label><select id="lastYear"><option value="1">1re année</option><option value="2">2e année</option><option value="3">3e année</option></select></div>
<div class="wide inline-year" id="yearExplanation">Année de rémunération déterminée automatiquement.</div>
<div class="wide"><label for="previous">Expérience antérieure en apprentissage</label><select id="previous"><option value="no">Aucun contrat précédent</option><option value="yes">Un ou plusieurs contrats précédents</option></select><p class="hint">L’expérience ne transforme pas automatiquement un nouveau contrat en 2e ou 3e année.</p></div>
<div id="previousBox" class="wide hidden"><div class="fields"><div><label for="obtained">Diplôme du précédent contrat obtenu ?</label><select id="obtained"><option value="unknown">À vérifier</option><option value="yes">Oui</option><option value="no">Non / contrat rompu</option></select></div><div><label for="employer">Situation du nouvel employeur</label><select id="employer"><option value="different">Différent, autre convention</option><option value="same">Même employeur</option><option value="convention">Différent, même convention</option></select></div><div class="wide"><label for="priorFloor">Minimum de maintien vérifié (€ brut / mois)</label><input id="priorFloor" type="number" min="0" max="100000" step=".01" placeholder="Montant après vérification du dossier"><p class="hint">Même employeur : rémunération précédente. Autre employeur : part réglementaire ou conventionnelle applicable. À établir avec le dernier contrat et le bulletin ; ne pas reporter aveuglément le salaire total.</p></div></div></div>
</div></div></div>
<div class="card"><div class="cardhead"><h2><span class="step">03</span>Compléments & cas particuliers</h2><span class="pill">Si applicable</span></div><div class="cardbody"><div class="fields"><div><label for="smc">Minimum conventionnel de l’emploi (€)</label><input id="smc" type="number" min="0" max="100000" step=".01" placeholder="Facultatif"><p class="hint">Base mensuelle à 100 %. Comparée au SMIC à partir de 21 ans.</p></div><div><label for="agreement">Plancher apprenti plus favorable (€)</label><input id="agreement" type="number" min="0" max="100000" step=".01" placeholder="Facultatif"><p class="hint">Montant brut prévu par l’accord, le contrat ou l’employeur public.</p></div>
<div class="wide"><label class="check"><input id="sameLevel" type="checkbox">Le diplôme déjà obtenu et le diplôme préparé sont de même niveau.</label><label class="check"><input id="related" type="checkbox">La nouvelle qualification est en rapport direct avec la précédente.</label><p class="hint">Avec un contrat d’au plus 12 mois : étudier la majoration de 15 points (D6222-30). Elle n’est pas liée automatiquement à l’intitulé CS ou MC.</p></div>
<div id="majorBox" class="wide hidden"><label for="majorYear">Année de grille de référence pour la majoration</label><select id="majorYear"><option value="">À vérifier avec le diplôme précédent</option><option value="1">1re année</option><option value="2">2e année</option><option value="3">3e année</option></select><p class="hint">Tenir compte de la durée du diplôme antérieur, y compris obtenu sous statut scolaire. La majoration porte sur le taux réglementaire, pas sur le minimum conventionnel.</p></div>
<div><label for="sector">Secteur employeur</label><select id="sector"><option value="private">Privé</option><option value="public">Public</option></select></div><div><label for="special">Autre situation à instruire</label><select id="special"><option value="none">Aucune signalée</option><option value="handicap">Aménagement lié au handicap</option><option value="rupture">Rupture / reprise de contrat</option><option value="other">Autre situation particulière</option></select></div>
<div class="wide"><label for="name">Libellé de la simulation <span class="muted">(facultatif)</span></label><input id="name" maxlength="80" placeholder="Ex. BTS · entrée directe en 2e année"><p class="hint">Utilisez un libellé sans nom d’apprenti ni donnée sensible.</p></div></div></div><div class="bottomcalc"><p class="hint">Le résultat s’actualise à chaque modification.</p><button class="btn primary" type="submit">Calculer ↗</button></div></div></form>
<aside class="rightcol"><div class="card result" id="estimation" aria-live="polite" aria-atomic="true"><div class="cardhead"><h2>Votre estimation</h2><span class="state" id="resultState">CALCUL AUTOMATIQUE</span></div><div class="cardbody" id="resultBody"></div></div><div class="card"><div class="cardhead"><h2>Comprendre ce résultat</h2><span class="pill">Pas à pas</span></div><div class="cardbody"><ul class="rulelist" id="reasonList"></ul><div id="warnings"></div></div></div><div class="card"><div class="cardbody"><h3>Une année, deux repères</h3><p class="small muted">L’année d’exécution décrit le contrat. Le positionnement décrit le cycle de formation. L’année de rémunération est le résultat de ces deux informations et des règles particulières.</p><button class="textbtn" data-go="tutoriel">Voir des exemples concrets →</button></div></div></aside></div></section>
<section id="comparateur" class="view hidden"><div class="intro"><div><p class="eyebrow">Décider avec les mêmes repères</p><h1>Comparer les scénarios</h1><p class="muted">Jusqu’à 6 situations, avec leur barème et leurs points à vérifier.</p></div><button class="btn primary" data-go="simulateur">+ Nouveau scénario</button></div><div class="toolbar"><button class="btn" id="exportCompare">Exporter en CSV</button><button class="btn" id="clearCompare">Vider le comparateur</button></div><div class="card sectiongap" id="compareBody"></div><p class="small muted">Chaque scénario conserve le barème utilisé lors de son ajout. Rechargez-le pour le recalculer avec le barème actuel.</p></section>
<section id="historique" class="view hidden"><div class="intro"><div><p class="eyebrow">Retrouver & réutiliser</p><h1>Historique des simulations</h1><p class="muted">Vos simulations enregistrées dans ce navigateur, sur cet appareil.</p></div><button class="btn" id="exportHistory">Exporter la sauvegarde</button></div><div class="notice">ⓘ <span>Aucune synchronisation entre collègues ou appareils. Exportez régulièrement votre sauvegarde ; vous pourrez la réimporter ici. Aucun enregistrement automatique à chaque frappe.</span></div><div class="toolbar"><input class="search" id="historySearch" placeholder="Rechercher un libellé ou un diplôme" aria-label="Rechercher dans l’historique"><button class="btn" id="importHistory">Importer une sauvegarde</button><button class="btn" id="clearHistory">Effacer l’historique</button><input type="file" id="historyFile" accept=".json" hidden></div><div class="card sectiongap" id="historyBody"></div></section>
<section id="tutoriel" class="view hidden"><div class="intro"><div><p class="eyebrow">Espace collègues</p><h1>Bien utiliser le simulateur</h1><p class="muted">Des rubriques expliquées, des exemples à réutiliser.</p></div><button class="btn" id="printGuide">Imprimer ce guide</button></div><div class="grid3"><div class="card guidecard"><span class="step">1</span><h3>Décrire la situation</h3><p>Préparez la fiche RNCP, le positionnement pédagogique, les dates du contrat et, si besoin, le dernier bulletin du contrat précédent.</p></div><div class="card guidecard"><span class="step">2</span><h3>Lire le raisonnement</h3><p>Vérifiez l’année de rémunération retenue, le pourcentage réglementaire, les bases comparées et les alertes avant de conclure.</p></div><div class="card guidecard"><span class="step">3</span><h3>Conserver & comparer</h3><p>Enregistrez une simulation, ajoutez des variantes au comparateur et exportez une sauvegarde pour la transmettre à un collègue.</p></div></div><div class="card"><div class="cardhead"><h2>Les rubriques, sans ambiguïté</h2></div>
<details open><summary>Année d’exécution, année de formation : que faut-il saisir ?</summary><p>Renseignez une seule fois l’année du contrat actuel : mois 1 à 12, 13 à 24 ou 25 à 36. Renseignez ensuite le positionnement au début de ce contrat : début du cycle ou entrée directe en 2e/3e année. Il n’y a pas de troisième menu répétant l’année en cours de formation. Le moteur en déduit l’année de grille et la justifie.</p><p>Exemple : un BTS rejoint directement en 2e année pour un contrat de 12 mois reste en 1re année d’exécution du nouveau contrat, mais relève de la rémunération de 2e année du cycle si la réduction est formalisée.</p></details>
<details><summary>Diplôme, niveau RNCP et durée de certification</summary><p>CAP : niveau 3 et cycle usuel de 24 mois ; bac professionnel : niveau 4 et 36 mois ; BTS : niveau 5 et 24 mois ; licence et bachelor : niveau 6, avec durée à confirmer. Les CS et anciennes MC peuvent être de niveaux différents : vérifiez la fiche de la certification. Ces repères préremplissent le formulaire et restent modifiables.</p><p>Un titre autonome en un an n’est pas nécessairement la dernière année d’un cycle de trois ans. Un niveau 6 ou un Bac +3 ne déclenche pas à lui seul la règle spéciale de licence professionnelle. Une licence générale s’étudie selon son positionnement réel.</p></details>
<details><summary>Âge, date et SMIC : comment les articuler ?</summary><p>La date sélectionne le SMIC de la période couverte par le barème. Saisissez l’âge applicable au mois de paie : le changement de tranche lié aux 18, 21 ou 26 ans s’applique le premier jour du mois suivant l’anniversaire. Pour anticiper une hausse, créez deux scénarios. Les dates hors de la période documentée produisent une alerte ; le barème n’est pas mis à jour automatiquement.</p></details>
<details><summary>Expérience précédente et maintien de rémunération</summary><p>Les anciens contrats ne s’additionnent pas pour déterminer l’année d’exécution du nouveau contrat. Si le précédent contrat a conduit à l’obtention du diplôme, examinez le maintien prévu à D6222-29 : rémunération précédente avec le même employeur ; part réglementaire ou conventionnelle applicable avec un employeur différent. Le champ « minimum de maintien vérifié » attend le montant établi après cette vérification. À défaut, le résultat reste un minimum de grille à instruire.</p></details>
<details><summary>CS, mention complémentaire et majoration de 15 points</summary><p>Vérifiez trois conditions : contrat d’au plus un an, diplôme de même niveau que celui déjà obtenu et qualification directement liée. Le diplôme précédent peut avoir été obtenu en formation initiale. Choisissez ensuite l’année de référence établie à partir du parcours antérieur. Exemple : CAP antérieur de deux ans puis nouveau CAP lié en un an, à 19 ans : référence de 2e année (51 %) majorée de 15 points, soit 66 % du SMIC. L’intitulé CS ne suffit jamais à déclencher cette majoration.</p></details>
<details><summary>Minimum conventionnel, plancher apprenti et brut mensuel</summary><p>Le minimum conventionnel correspond à la rémunération mensuelle à 100 % de l’emploi occupé. À partir de 21 ans, le moteur compare le pourcentage du SMIC au même pourcentage de cette base. Le plancher apprenti correspond, lui, à un montant déjà établi par un accord ou le contrat : il est comparé directement. Le résultat est une estimation brute à temps plein, hors heures supplémentaires, avantages en nature, absences et calcul des cotisations. Il ne s’agit pas d’un salaire net.</p></details>
<details><summary>Réduction, prolongation, handicap et employeurs publics</summary><p>Documentez toute réduction avec le CFA et l’employeur. Si le décalage ne correspond pas à une année entière, le moteur demande une instruction manuelle. Pour une prolongation, choisissez l’année de rémunération précédant la prolongation. Un aménagement lié au handicap, une rupture ou une reprise demande une étude individuelle ; aucun bonus arbitraire n’est appliqué. Dans le public, renseignez le montant plus favorable éventuellement prévu par l’employeur.</p></details>
<details><summary>Historique, confidentialité et mise à jour</summary><p>Les enregistrements sont locaux, limités à 200 simulations et ne sont pas partagés automatiquement. Une navigation privée ou un effacement des données peut les supprimer. Utilisez des libellés anonymes. L’export JSON contient les entrées, le résultat et le barème associé. La page Règles & barème permet un ajustement local, exportable ; une mise à jour commune exige de modifier puis republier la version du site.</p></details></div>
<h2 class="sectiongap">Exemples prêts à explorer</h2><p class="small muted">Chaque exemple remplace les champs du formulaire sans effacer vos simulations enregistrées.</p><div class="grid3"><div class="card guidecard"><h3>Bachelor autonome en 1 an</h3><p>19 ans, premier contrat, niveau 6. Aucun décalage de cycle attesté.</p><button class="btn sectiongap" data-example="bachelor">Explorer le cas →</button></div><div class="card guidecard"><h3>BTS : entrée directe en 2e année</h3><p>19 ans, cycle de 24 mois ramené à 12 mois avec positionnement.</p><button class="btn sectiongap" data-example="bts">Explorer le cas →</button></div><div class="card guidecard"><h3>Licence professionnelle</h3><p>22 ans, formation en un an. Application de la règle spécifique.</p><button class="btn sectiongap" data-example="lp">Explorer le cas →</button></div></div></section>
<section id="parametres" class="view hidden"><div class="intro"><div><p class="eyebrow">Un référentiel explicite</p><h1>Règles & barème</h1><p class="muted">Des paramètres versionnés et des sources accessibles.</p></div><button class="btn" id="exportConfig">Exporter le barème</button></div><div class="notice">ⓘ <span>Les modifications ici s’appliquent uniquement à votre navigateur. Pour tous les collègues, il faudra intégrer le barème validé au site et republier. Aucun droit d’administration partagé n’est simulé.</span></div><div class="card"><div class="cardhead"><h2>Grille réglementaire</h2><span class="pill" id="configVersion"></span></div><div class="tablewrap" id="gridBody"></div><div class="cardbody small muted">Pourcentage du SMIC ; à partir de 21 ans, comparaison au même pourcentage du minimum conventionnel si plus favorable. La majoration de 15 points est traitée séparément.</div></div><div class="card"><div class="cardhead"><h2>Sources de référence</h2><span class="pill">Consultées le 03/11/2026</span></div><div class="cardbody linklist"><a href="https://www.service-public.gouv.fr/particuliers/vosdroits/F2918" target="_blank" rel="noopener">Service Public — Contrat d’apprentissage et rémunération ↗</a><a href="https://www.urssaf.fr/accueil/outils-documentation/taux-baremes/montant-smic.html" target="_blank" rel="noopener">Urssaf — Montants et dates d’effet du SMIC ↗</a><a href="https://code.travail.gouv.fr/code-du-travail/d6222-26" target="_blank" rel="noopener">D6222-26 — Grille selon l’âge ↗</a><a href="https://code.travail.gouv.fr/code-du-travail/d6222-28-1" target="_blank" rel="noopener">D6222-28-1 — Cycle réduit ↗</a><a href="https://code.travail.gouv.fr/code-du-travail/d6222-29" target="_blank" rel="noopener">D6222-29 — Succession de contrats ↗</a><a href="https://code.travail.gouv.fr/code-du-travail/d6222-30" target="_blank" rel="noopener">D6222-30 — Majoration de 15 points ↗</a><a href="https://code.travail.gouv.fr/code-du-travail/d6222-32" target="_blank" rel="noopener">D6222-32 — Licence professionnelle ↗</a></div></div><div class="card"><div class="cardhead"><h2>Éditer le référentiel local</h2><button class="textbtn" id="resetConfig">Rétablir la référence</button></div><div class="cardbody"><p class="small muted">Ajoutez une période de SMIC sans écraser les anciennes. Pour une évolution juridique du calcul, le moteur doit aussi être revu et testé. Chaque simulation conserve une copie de son référentiel.</p><label for="configEditor">Configuration JSON · SMIC, taux, période documentée et version</label><textarea id="configEditor" rows="17" spellcheck="false" style="font-family:ui-monospace,monospace;font-size:12px"></textarea><div class="toolbar sectiongap"><button class="btn primary" id="saveConfig">Appliquer à ce navigateur</button><button class="btn" id="importConfig">Importer un barème</button><input type="file" id="configFile" accept=".json" hidden></div><div id="configError" role="alert"></div></div></div><div class="card"><div class="cardbody"><h3>Procédure de mise à jour commune</h3><ol class="small muted"><li>Vérifier la source officielle, la date d’effet et les situations concernées.</li><li>Mettre à jour la configuration, conserver les périodes antérieures et incrémenter la version.</li><li>Contrôler les cas de référence : tranches d’âge, entrée avancée, licence pro, succession et majoration.</li><li>Republier le site et communiquer la version aux collègues. Recalculer les anciens scénarios si nécessaire.</li></ol></div></div></section>
<footer class="footer"><span>CFA de l’Académie de Nice / GIP FIPAN · Outil d’aide à l’étude des contrats</span><span>Estimation indicative · Barème versionné · Données locales</span></footer></main></div></div><div id="toast" class="toast hidden" role="status"></div><noscript><p>Activez JavaScript pour utiliser le calcul, le comparateur et l’historique.</p></noscript>
<script>
'use strict';
// RÉFÉRENTIEL : seul point de modification des taux et périodes de SMIC.
const DEFAULT_CONFIG={schema:1,version:'2026.11-r1',verifiedOn:'2026-11-03',coverageEnd:'2026-11-03',smic:[{from:'2026-01-01',monthly:1823.03},{from:'2026-06-01',monthly:1867.02}],rates:{u18:[27,39,55],a18:[43,51,67],a21:[53,61,78],a26:[100,100,100]},majoration:15};
const DIPLOMAS={cap:{label:'CAP',level:'3',months:24},bac:{label:'Bac professionnel',level:'4',months:36},cs:{label:'Certificat de spécialisation',level:'4',months:12},mc:{label:'Mention complémentaire',level:'4',months:12},bts:{label:'BTS',level:'5',months:24},licence:{label:'Licence générale',level:'6',months:36},lp:{label:'Licence professionnelle',level:'6',months:12},bachelor:{label:'Bachelor / titre RNCP',level:'6',months:12},other:{label:'Autre diplôme ou titre',level:'6',months:12}};
const BASE={age:19,date:'2026-11-03',diploma:'bts',level:'5',rncp:'',cycle:24,duration:24,year:1,entry:1,adjust:'standard',lastYear:1,previous:'no',obtained:'unknown',employer:'different',priorFloor:0,smc:0,agreement:0,sameLevel:false,related:false,majorYear:0,sector:'private',special:'none',name:''};
function clone(v){return JSON.parse(JSON.stringify(v))}
function isDate(s){return /^\d{4}-\d{2}-\d{2}$/.test(s)&&!Number.isNaN(Date.parse(s))&&new Date(s).toISOString().slice(0,10)===s}
function validateConfig(c){if(!c||c.schema!==1||typeof c.version!=='string'||!c.version.trim()||c.version.length>100||!isDate(c.verifiedOn)||!isDate(c.coverageEnd)||!Array.isArray(c.smic)||!c.smic.length||c.smic.length>100)throw Error('Version, dates ou périodes SMIC invalides.');let last='';for(const p of c.smic){if(!isDate(p.from)||p.from<=last||!Number.isFinite(p.monthly)||p.monthly<=0||p.monthly>100000)throw Error('Les périodes doivent être ordonnées, uniques et les montants positifs.');last=p.from}if(c.coverageEnd<last||c.coverageEnd<c.verifiedOn)throw Error('La fin de couverture doit couvrir la vérification et les périodes.');for(const k of ['u18','a18','a21','a26'])if(!Array.isArray(c.rates?.[k])||c.rates[k].length!==3||c.rates[k].some(v=>!Number.isFinite(v)||v<0||v>200))throw Error('Chaque tranche doit contenir trois taux compris entre 0 et 200.');if(!Number.isFinite(c.majoration)||c.majoration<0||c.majoration>100)throw Error('Majoration invalide.');return c}
// MOTEUR PUR : indépendant du DOM pour permettre les tests et les évolutions.
function calculate(x,c){validateConfig(c);const errors=[],warnings=[],reasons=[];
for(const [k,min,max] of [['age',15,80],['cycle',6,60],['duration',6,60],['year',1,3],['entry',1,3],['lastYear',1,3]])if(!Number.isInteger(x[k])||x[k]<min||x[k]>max)errors.push('Valeur invalide : '+k+'.');
for(const k of ['smc','agreement','priorFloor'])if(!Number.isFinite(x[k])||x[k]<0||x[k]>100000)errors.push('Montant invalide : '+k+'.');
if(!isDate(x.date))errors.push('Renseignez une date valide.');if(!Object.hasOwn(DIPLOMAS,x.diploma))errors.push('Diplôme non reconnu.');if(!['standard','reduced','extended'].includes(x.adjust))errors.push('Aménagement non reconnu.');if(!['3','4','5','6','7'].includes(x.level))errors.push('Niveau non reconnu.');if(![0,1,2,3].includes(x.majorYear))errors.push('Année de majoration invalide.');if(errors.length)return {errors};
let provisional=false;let period=c.smic.filter(p=>p.from<=x.date).at(-1);if(!period)return{errors:['Aucun SMIC documenté pour cette date. Ajoutez une période vérifiée dans Règles & barème.']};if(x.date>c.coverageEnd){provisional=true;warnings.push('Date postérieure à la période vérifiée du barème : confirmer le SMIC et les règles en vigueur avant utilisation.');}
let y=x.year+x.entry-1;
if(x.entry>1){reasons.push('Positionnement en '+x.entry+'e année du cycle : décalage de '+(x.entry-1)+' an(s) pris en compte.');warnings.push('Entrée directe : faire confirmer le positionnement et la réduction par le CFA et l’employeur.');if(x.cycle!==x.duration+(x.entry-1)*12){warnings.push('Le positionnement et les durées ne concordent pas sur des années entières : année de rémunération à confirmer manuellement.');provisional=true}}
if(x.adjust==='reduced'&&x.entry===1){const shift=(x.cycle-x.duration)/12;if(shift>0&&Number.isInteger(shift)){y=x.year+shift;reasons.push('Réduction de '+shift+' an(s) : rémunération replacée dans le cycle normal (D6222-28-1).')}else{warnings.push('Réduction non déterminable en années entières : le taux affiché est une base de grille à faire valider.');provisional=true}}
if(x.adjust==='standard'&&x.entry===1&&x.duration<x.cycle){warnings.push('Contrat plus court que le cycle : indiquez le positionnement ou la réduction formalisée.');provisional=true}
if(x.adjust==='extended'){y=x.lastYear;reasons.push('Prolongation : maintien de l’année de grille précédant la prolongation.');warnings.push('Vérifier le fondement et les dates de la prolongation (D6222-28 et D6222-28-2).')}
if(x.adjust!=='extended'&&x.duration>x.cycle){warnings.push('La durée du contrat dépasse le cycle : vérifier la prolongation et la période simulée.');provisional=true}
if(x.adjust!=='extended'&&(x.year-1)*12>=x.duration){warnings.push('L’année d’exécution dépasse la durée du contrat renseignée.');provisional=true}
if(x.diploma==='lp'){y=2;reasons.push('Licence professionnelle : règle spécifique de 2e année (D6222-32).')}
if(y>3){warnings.push('Progression au-delà de la grille de trois ans : taux de 3e année affiché à titre de repère, étude individuelle requise.');y=3;provisional=true}
const band=x.age<18?'u18':x.age<21?'a18':x.age<26?'a21':'a26';let baseRate=c.rates[band][y-1],regRate=baseRate;
const eligible=x.sameLevel&&x.related&&x.duration<=12;
if(eligible){if(x.majorYear){y=x.majorYear;baseRate=c.rates[band][x.majorYear-1];regRate=baseRate+c.majoration;reasons.push('Conditions D6222-30 déclarées : référence de '+x.majorYear+'e année ('+baseRate+' %) + '+c.majoration+' points.');warnings.push('Majoration : vérifier le diplôme obtenu, le lien direct et l’année de référence documentée.')}else{provisional=true;warnings.push('Majoration potentiellement applicable : choisissez l’année de grille de référence après étude du diplôme antérieur. Elle n’est pas incluse dans le montant affiché.')}}else if(x.sameLevel||x.related){warnings.push('La majoration exige les deux conditions et un contrat d’au plus 12 mois. Aucune majoration appliquée.')}
const smic=period.monthly,legal=smic*regRate/100,conventional=x.age>=21?x.smc*c.rates[band][y-1]/100:0;
let floor=0;if(x.previous==='yes'){if(x.obtained==='yes'&&x.priorFloor>0){floor=x.priorFloor;reasons.push('Maintien documenté du contrat précédent : '+floor.toFixed(2)+' € comparés au calcul actuel.');warnings.push('Minimum de maintien saisi sous responsabilité du dossier ; vérifier sa revalorisation éventuelle.')}else if(x.obtained!=='no'){warnings.push('Succession de contrats : diplôme obtenu et minimum de maintien à vérifier. Le montant affiché exclut ce maintien non établi.');provisional=true}else warnings.push('Diplôme précédent non obtenu : pas de maintien automatique au titre de D6222-29 ; vérifier rupture et reprise.')}
const amount=Math.round(Math.max(legal,conventional,floor,x.agreement)*100)/100;
let origin=amount===Math.round(legal*100)/100?'Minimum réglementaire sur SMIC':amount===Math.round(conventional*100)/100?'Minimum sur base conventionnelle':amount===Math.round(floor*100)/100?'Maintien du contrat précédent':'Plancher plus favorable';
reasons.unshift('Tranche '+(band==='u18'?'moins de 18 ans':band==='a18'?'18–20 ans':band==='a21'?'21–25 ans':'26 ans et plus')+' · '+y+'e année de rémunération.');
reasons.push('SMIC retenu : '+smic.toFixed(2)+' € mensuels, période du '+period.from+'.');
if(x.smc>0&&x.age>=21)reasons.push('Comparaison avec '+c.rates[band][y-1]+' % du minimum conventionnel ; la majoration de 15 points ne majore pas cette base.');
if(x.age>=30||x.age<16)warnings.push('Âge hors du cadre ordinaire d’accès : vérifier la dérogation applicable.');
if(['bachelor','licence'].includes(x.diploma))warnings.push('Confirmer la nature du cycle et la fiche RNCP : ni le niveau 6 ni un BTS antérieur ne suffisent à fixer l’année de grille.');
if(['cs','mc'].includes(x.diploma))warnings.push('Confirmer le niveau de ce CS/MC et les éventuelles conditions de majoration.');
if(x.sector==='public')warnings.push('Employeur public : vérifier toute rémunération plus favorable et la renseigner dans le plancher apprenti.');
if(x.special!=='none'){warnings.push('Situation particulière signalée : résultat de grille provisoire, à instruire individuellement avant contrat.');provisional=true}
return{errors:[],amount,regRate,equivalent:Math.round(amount/smic*10000)/100,baseRate,year:y,smic,origin,legal:Math.round(legal*100)/100,conventional:Math.round(conventional*100)/100,provisional,reasons,warnings,version:c.version};}
if(typeof document!=='undefined'){
const $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])),eur=n=>n.toLocaleString('fr-FR',{style:'currency',currency:'EUR'}),ordinal=n=>n===1?'1re':n+'e';
let memory={},storageOK=true;function readStore(k,f){try{const t=localStorage.getItem('reperes-'+k);return t?JSON.parse(t):clone(f)}catch{storageOK=false;return clone(f)}}function writeStore(k,v){memory[k]=v;try{localStorage.setItem('reperes-'+k,JSON.stringify(v));return true}catch{storageOK=false;toast('Stockage indisponible : exportez vos données avant de fermer cette page.');return false}}
let config;try{config=validateConfig(readStore('config',DEFAULT_CONFIG))}catch{config=clone(DEFAULT_CONFIG)}let history=readStore('history',[]),comparison=readStore('compare',[]);if(!Array.isArray(history))history=[];if(!Array.isArray(comparison))comparison=[];let current=null,lastInput=null,timer;
function toast(t){$('toast').textContent=t;$('toast').classList.remove('hidden');clearTimeout(timer);timer=setTimeout(()=>$('toast').classList.add('hidden'),4500)}
function getInput(){const x={};for(const [k,v] of Object.entries(BASE)){const el=$(k);x[k]=typeof v==='boolean'?el.checked:typeof v==='number'?Number(el.value):el.value}return x}
function setInput(x){for(const [k,v]of Object.entries({...BASE,...x})){const el=$(k);if(!el)continue;if(typeof BASE[k]==='boolean')el.checked=Boolean(v);else el.value=String(v)}sync();render()}
function sync(){$('previousBox').classList.toggle('hidden',$('previous').value!=='yes');$('extensionBox').classList.toggle('hidden',$('adjust').value!=='extended');$('majorBox').classList.toggle('hidden',!($('sameLevel').checked&&$('related').checked&&Number($('duration').value)<=12))}
function render(){sync();let x=getInput();let r=calculate(x,config);lastInput=x;current=r;$('resultState').textContent=r.errors.length?'À COMPLÉTER':r.provisional?'À INSTRUIRE':'CALCUL ACTUALISÉ';if(r.errors.length){$('resultBody').innerHTML='<div class="error">'+r.errors.map(esc).join('<br>')+'</div>';$('reasonList').innerHTML='';$('warnings').innerHTML='';$('yearExplanation').textContent='Complétez les champs pour déterminer l’année de rémunération.';return}
$('yearExplanation').textContent='Année de rémunération retenue : '+ordinal(r.year)+' année'+(r.provisional?' · à confirmer selon le dossier.':' · voir le raisonnement dans le résultat.');
$('resultBody').innerHTML='<div class="resultsub">'+esc(DIPLOMAS[x.diploma].label)+' · '+esc(x.age)+' ans</div><div class="money">'+eur(r.amount)+'</div><div class="resultsub">brut / mois · estimation à temps plein</div><div class="rate">'+r.regRate+' % du SMIC · taux réglementaire'+(r.provisional?' de référence':'')+'</div><dl><div><dt>Année de rémunération</dt><dd>'+ordinal(r.year)+' année</dd></div><div><dt>SMIC mensuel de référence</dt><dd>'+eur(r.smic)+'</dd></div><div><dt>Minimum sur SMIC</dt><dd>'+eur(r.legal)+'</dd></div><div><dt>Montant retenu</dt><dd>'+esc(r.origin)+'</dd></div>'+(Math.abs(r.equivalent-r.regRate)>.01?'<div><dt>Équivalent du montant en SMIC</dt><dd>'+r.equivalent+' %</dd></div>':'')+'<div><dt>Barème utilisé</dt><dd>'+esc(r.version)+'</dd></div></dl><div class="resultactions"><button type="button" class="btn" id="saveSim">Enregistrer</button><button type="button" class="btn outline" id="addCompare">+ Comparer</button></div>';
$('saveSim').onclick=saveSim;$('addCompare').onclick=addCompare;$('reasonList').innerHTML=r.reasons.map(s=>'<li><span class="tick">✓</span><span>'+esc(s)+'</span></li>').join('');$('warnings').innerHTML=(r.provisional?'<div class="warning"><b>Estimation provisoire</b><p>Des informations restent à établir ; ce montant ne constitue pas un minimum définitif validé pour ce dossier.</p></div>':'')+'<details style="padding:12px 0;border:0" '+(r.provisional?'open':'')+'><summary style="font-size:12px">Points à vérifier ('+(r.warnings.length+1)+')</summary>'+r.warnings.map(s=>'<div class="warning">'+esc(s)+'</div>').join('')+'<div class="warning">Confirmer la convention collective et les dispositions plus favorables. Estimation brute, hors traitement de paie.</div></details>';
}
function showView(v){if(!$(v)?.classList.contains('view'))return;document.querySelectorAll('.view').forEach(el=>el.classList.toggle('hidden',el.id!==v));document.querySelectorAll('.nav button').forEach(b=>{b.classList.toggle('active',b.dataset.view===v);b.setAttribute('aria-current',b.dataset.view===v?'page':'false')});if(v==='historique')renderHistory();if(v==='comparateur')renderCompare();if(v==='parametres')renderConfig();window.scrollTo({top:0,behavior:'smooth'})}
function record(){return{id:globalThis.crypto?.randomUUID?.()||Date.now().toString(36)+Math.random().toString(36).slice(2),savedAt:new Date().toISOString(),input:clone(lastInput),result:clone(current),config:clone(config)}}
function saveSim(){if(current.errors.length)return;history.unshift(record());history=history.slice(0,200);writeStore('history',history);toast('Simulation enregistrée'+(storageOK?' dans ce navigateur.':' en mémoire seulement.'))}
function addCompare(){if(current.errors.length)return;if(comparison.length>=6){toast('Le comparateur contient déjà 6 scénarios. Retirez-en un pour continuer.');return}comparison.push(record());writeStore('compare',comparison);updateCount();toast('Scénario ajouté au comparateur.')}function updateCount(){$('compareCount').textContent=comparison.length}
function labelRec(s){return s.input.name||DIPLOMAS[s.input.diploma]?.label||'Simulation'}
function empty(title,desc){return '<div class="empty"><b>'+title+'</b>'+desc+'</div>'}
function renderCompare(){const el=$('compareBody');if(!comparison.length){el.innerHTML=empty('Vos variantes, côte à côte','Ajoutez un premier scénario depuis le résultat du simulateur.');return}el.innerHTML='<div class="tablewrap"><table><thead><tr><th>Scénario</th>'+comparison.map(s=>'<th>'+esc(labelRec(s))+'<br><span class="muted">'+esc(s.result.version)+'</span></th>').join('')+'</tr></thead><tbody>'+[['Montant brut mensuel',s=>'<strong>'+eur(s.result.amount)+'</strong>'],['Taux réglementaire',s=>s.result.regRate+' % du SMIC'],['Année de rémunération',s=>ordinal(s.result.year)],['Âge / diplôme',s=>esc(s.input.age)+' ans · '+esc(DIPLOMAS[s.input.diploma]?.label)],['Positionnement / contrat',s=>ordinal(s.input.entry)+' à l’entrée / '+ordinal(s.input.year)+' du contrat'],['Date / SMIC',s=>esc(s.input.date)+'<br>'+eur(s.result.smic)],['Écart avec le premier',s=>eur(s.result.amount-comparison[0].result.amount)],['Vigilances',s=>(s.result.provisional?'<b>À instruire</b><br>':'')+s.result.warnings.map(esc).join('<br><br>')],['Actions',s=>'<button class="textbtn" data-load-compare="'+esc(s.id)+'">Recharger</button> <button class="textbtn" data-remove-compare="'+esc(s.id)+'">Retirer</button>']].map(([l,f])=>'<tr><th>'+l+'</th>'+comparison.map(s=>'<td>'+f(s)+'</td>').join('')+'</tr>').join('')+'</tbody></table></div>'}
function renderHistory(){const query=$('historySearch').value.toLowerCase();const list=history.filter(s=>(labelRec(s)+' '+DIPLOMAS[s.input.diploma]?.label).toLowerCase().includes(query));$('historyBody').innerHTML=!list.length?empty(history.length?'Aucun résultat':'Aucune simulation enregistrée','Utilisez « Enregistrer » dans le simulateur pour retrouver un dossier ici.'):'<div class="tablewrap"><table><thead><tr><th>Simulation</th><th>Enregistrement</th><th>Brut / mois</th><th>Barème</th><th>Actions</th></tr></thead><tbody>'+list.map(s=>'<tr><td><b>'+esc(labelRec(s))+'</b><br><span class="small muted">'+esc(s.input.age)+' ans · '+ordinal(s.result.year)+' année'+(s.result.provisional?' · à instruire':'')+'</span></td><td>'+esc(new Date(s.savedAt).toLocaleString('fr-FR'))+'</td><td><strong>'+eur(s.result.amount)+'</strong></td><td>'+esc(s.result.version)+'</td><td><button class="textbtn" data-load-history="'+esc(s.id)+'">Recharger</button><button class="textbtn" data-compare-history="'+esc(s.id)+'">Comparer</button><button class="textbtn" data-remove-history="'+esc(s.id)+'">Supprimer</button></td></tr>').join('')+'</tbody></table></div>'}
function download(name,data,type='application/json'){const url=URL.createObjectURL(new Blob([data],{type}));const a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
function renderConfig(){$('configVersion').textContent=config.version;$('configEditor').value=JSON.stringify(config,null,2);$('gridBody').innerHTML='<table><thead><tr><th>Année de grille</th><th>Moins de 18 ans</th><th>18–20 ans</th><th>21–25 ans</th><th>26 ans et +</th></tr></thead><tbody>'+[0,1,2].map(i=>'<tr><td>'+ordinal(i+1)+' année</td>'+['u18','a18','a21','a26'].map(k=>'<td>'+config.rates[k][i]+' %</td>').join('')+'</tr>').join('')+'</tbody></table><div class="cardbody small">'+config.smic.map(p=>'Depuis le '+esc(p.from)+' : <b>'+eur(p.monthly)+'</b>').join(' &nbsp; • &nbsp; ')+'<br>Couverture vérifiée jusqu’au '+esc(config.coverageEnd)+'.</div>'}
function loadRec(s){setInput(s.input);showView('simulateur');toast('Entrées rechargées et recalculées avec le barème actuel ('+config.version+').')}
$('simform').addEventListener('submit',e=>{e.preventDefault();render();toast(current.errors.length?'Complétez les champs signalés.':'Calcul actualisé.');});$('simform').addEventListener('input',render);$('simform').addEventListener('change',e=>{if(e.target.id==='diploma'){const d=DIPLOMAS[$('diploma').value];$('level').value=d.level;$('cycle').value=d.months;$('duration').value=d.months;$('entry').value='1';$('year').value='1';$('adjust').value='standard';$('majorYear').value='0'}render()});
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.view)showView(b.dataset.view);if(b.dataset.go)showView(b.dataset.go);if(b.dataset.example){let x={...BASE};if(b.dataset.example==='bachelor')Object.assign(x,{diploma:'bachelor',level:'6',cycle:12,duration:12,name:'Bachelor autonome · 19 ans'});if(b.dataset.example==='bts')Object.assign(x,{entry:2,duration:12,adjust:'reduced',name:'BTS entrée directe · 19 ans'});if(b.dataset.example==='lp')Object.assign(x,{age:22,diploma:'lp',level:'6',cycle:12,duration:12,name:'Licence pro · 22 ans'});setInput(x);showView('simulateur')}
for(const [key,list]of [['loadHistory',history],['loadCompare',comparison]])if(b.dataset[key]){const s=list.find(s=>s.id===b.dataset[key]);if(s)loadRec(s)}
if(b.dataset.removeCompare){comparison=comparison.filter(s=>s.id!==b.dataset.removeCompare);writeStore('compare',comparison);updateCount();renderCompare()}if(b.dataset.removeHistory&&confirm('Supprimer cette simulation de l’historique ?')){history=history.filter(s=>s.id!==b.dataset.removeHistory);writeStore('history',history);renderHistory()}if(b.dataset.compareHistory){if(comparison.length>=6){toast('Limite de 6 scénarios atteinte.');return}const s=history.find(s=>s.id===b.dataset.compareHistory);if(s){const copy=clone(s);copy.id=Date.now().toString(36)+Math.random().toString(36).slice(2);comparison.push(copy);writeStore('compare',comparison);updateCount();toast('Version enregistrée ajoutée au comparateur.')}}});
$('historySearch').oninput=renderHistory;$('exportHistory').onclick=()=>download('reperes-simulations.json',JSON.stringify({schema:1,exportedAt:new Date().toISOString(),simulations:history},null,2));$('exportConfig').onclick=()=>download('reperes-bareme.json',JSON.stringify(config,null,2));$('clearHistory').onclick=()=>{if(confirm('Effacer toutes les simulations enregistrées dans ce navigateur ? Pensez à exporter une sauvegarde.')){history=[];writeStore('history',history);renderHistory()}};$('clearCompare').onclick=()=>{if(confirm('Vider les scénarios du comparateur ?')){comparison=[];writeStore('compare',comparison);updateCount();renderCompare()}};
$('exportCompare').onclick=()=>{if(!comparison.length){toast('Ajoutez au moins un scénario.');return}const cell=s=>'"'+String(s).replace(/"/g,'""').replace(/^[=+@\-]/,"' $&")+'"';const rows=[['Scénario','Diplôme','Âge','Date étudiée','Année rémunération','Taux SMIC','Brut mensuel','SMIC','Version','À instruire','Vigilances'],...comparison.map(s=>[labelRec(s),DIPLOMAS[s.input.diploma].label,s.input.age,s.input.date,s.result.year,s.result.regRate,String(s.result.amount).replace('.',','),String(s.result.smic).replace('.',','),s.result.version,s.result.provisional?'Oui':'Non',s.result.warnings.join(' | ')])];download('reperes-comparaison.csv','\uFEFF'+rows.map(row=>row.map(cell).join(';')).join('\r\n'),'text/csv;charset=utf-8')};
$('importHistory').onclick=()=>$('historyFile').click();$('historyFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{if(f.size>5000000)throw Error('Fichier trop volumineux (maximum 5 Mo).');const data=JSON.parse(await f.text());if(data.schema!==1||!Array.isArray(data.simulations)||data.simulations.length>200)throw Error('Sauvegarde non reconnue ou supérieure à 200 simulations.');const imported=data.simulations.map(s=>{if(!s.input||!s.config||!isDate(s.input.date)||!Number.isFinite(Date.parse(s.savedAt)))throw Error('Une simulation est invalide.');const x={...BASE,...s.input};if(typeof x.name!=='string'||x.name.length>80)throw Error('Libellé invalide.');const r=calculate(x,s.config);if(r.errors.length)throw Error(r.errors.join(' '));return{...record(),savedAt:s.savedAt,input:x,config:s.config,result:r}});history=[...imported,...history].slice(0,200);writeStore('history',history);renderHistory();toast(imported.length+' simulation(s) importée(s).')}catch(err){toast('Import refusé : '+err.message)}e.target.value=''};
$('importConfig').onclick=()=>$('configFile').click();$('configFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{if(f.size>100000)throw Error('Fichier trop volumineux.');const c=validateConfig(JSON.parse(await f.text()));$('configEditor').value=JSON.stringify(c,null,2);toast('Barème chargé dans l’éditeur. Cliquez sur Appliquer pour l’utiliser.')}catch(err){toast('Import refusé : '+err.message)}e.target.value=''};
$('saveConfig').onclick=()=>{try{const next=validateConfig(JSON.parse($('configEditor').value));if(JSON.stringify(next)!==JSON.stringify(config)&&next.version===config.version)throw Error('Changez la version pour identifier ce nouveau barème.');config=next;writeStore('config',config);$('configError').textContent='';renderConfig();render();toast('Barème appliqué localement. Les simulations enregistrées conservent leur référentiel.')}catch(err){$('configError').className='error';$('configError').textContent=err.message}};$('resetConfig').onclick=()=>{if(confirm('Rétablir le barème de référence dans ce navigateur ?')){config=clone(DEFAULT_CONFIG);writeStore('config',config);renderConfig();render();toast('Barème de référence rétabli.')}};$('printGuide').onclick=()=>window.print();updateCount();render();if(!storageOK)toast('Stockage local indisponible : utilisez les exports pour conserver vos simulations.');
}
</script></body></html>
